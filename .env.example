# =============================================================================
# Bayora runtime configuration — TEMPLATE ONLY.
#
# 1. Copy this file to `.env` in the repository root:
#        cp .env.example .env        (POSIX)
#        copy .env.example .env      (Windows)
# 2. Replace EVERY `change-me-*` placeholder with a strong random value.
# 3. Never commit `.env`. It is listed in `.gitignore`; if it ever reaches a
#    remote, rotate every value in it before doing anything else.
#
# Generating strong values:
#    openssl rand -hex 32
#    python -c "import secrets;print(secrets.token_urlsafe(32))"
#
# `docker compose` reads this file automatically for ${VAR} interpolation and
# aborts with a clear error when a variable marked `:?` is missing, so a
# half-filled `.env` fails loudly instead of silently falling back to a
# default secret.
#
# NOTE ON SCOPE: the service containers do NOT receive this file wholesale.
# Each service is given only the variables it needs (and, in the case of the
# controller, only the service tokens it legitimately uses). Injecting the
# whole file everywhere would hand every container every other service's
# shared token.
# =============================================================================

# --- General -----------------------------------------------------------------
# development | test | production
BAYORA_ENV=production
# Role of THIS container. In compose mode each service sets its own role.
# monolith | controller | red-service | blue-policy-service | model-gateway
# evaluation-service | audit-collector
BAYORA_SERVICE_ROLE=controller
BAYORA_APP_VERSION=1.0.0
# Informational only: the application currently hardcodes its log level, so
# this value is not yet consumed by the process.
BAYORA_LOG_LEVEL=INFO
# Informational only: the deployment mode is DERIVED from BAYORA_SERVICE_ROLE
# (monolith-dev vs compose-services). This variable is not read by the app.
BAYORA_DEPLOYMENT_MODE=compose-services

# --- Shared service tokens ---------------------------------------------------
# One token per internal service. Each service knows ONLY its own token; the
# API controller is the single exception because it is the only component
# that calls every other component and therefore needs all five.
# Generate a SEPARATE value per line.
BAYORA_SERVICE_TOKEN_RED=change-me-generate-a-unique-token-red
BAYORA_SERVICE_TOKEN_BLUE=change-me-generate-a-unique-token-blue
BAYORA_SERVICE_TOKEN_MODEL=change-me-generate-a-unique-token-model
BAYORA_SERVICE_TOKEN_EVAL=change-me-generate-a-unique-token-eval
BAYORA_SERVICE_TOKEN_AUDIT=change-me-generate-a-unique-token-audit

# --- Demo account passwords --------------------------------------------------
# The bootstrapper seeds five demo accounts on first start. Set these (and
# BAYORA_SEED_DEMO_USERS=false for a real deployment) so the shipped default
# passwords in the source tree are never usable.
BAYORA_DEMO_ADMIN_PASSWORD=change-me-admin-password
BAYORA_DEMO_RED_PASSWORD=change-me-red-password
BAYORA_DEMO_RED2_PASSWORD=change-me-red2-password
BAYORA_DEMO_BLUE_PASSWORD=change-me-blue-password
BAYORA_DEMO_AUDITOR_PASSWORD=change-me-auditor-password
BAYORA_SEED_DEMO_USERS=true

# --- PostgreSQL --------------------------------------------------------------
# The database host used by the `postgres` service. The four logical stores
# live on this one host and are separated by database, not by host.
BAYORA_POSTGRES_USER=bayora
BAYORA_POSTGRES_PASSWORD=change-me-generate-a-strong-postgres-password
BAYORA_POSTGRES_DB=bayora_controller

# --- Database URLs (one trust domain per store) ------------------------------
# In compose mode each URL points at the postgres service on the internal
# database network. The password is interpolated from the value above, so it
# only has to be rotated in ONE place.
BAYORA_DATABASE_URL=postgresql://bayora:${BAYORA_POSTGRES_PASSWORD}@postgres:5432/bayora_controller
BAYORA_POLICY_DATABASE_URL=postgresql://bayora:${BAYORA_POSTGRES_PASSWORD}@postgres:5432/bayora_policy
BAYORA_EVALUATOR_DATABASE_URL=postgresql://bayora:${BAYORA_POSTGRES_PASSWORD}@postgres:5432/bayora_evaluator
BAYORA_AUDIT_DATABASE_URL=postgresql://bayora:${BAYORA_POSTGRES_PASSWORD}@postgres:5432/bayora_audit

# --- Filesystem paths --------------------------------------------------------
# Writable directories inside the containers. They are backed by per-service
# named volumes (the root filesystem is read-only).
BAYORA_DATA_DIR=/app/data
BAYORA_QUARANTINE_DIR=/app/data/quarantine
# Ed25519 checkpoint signing key. Generated on first boot with mode 0600 into
# the shared audit key volume. Back it up: losing it means existing
# checkpoints can no longer be verified against the collector's anchor.
BAYORA_AUDIT_SIGNING_KEY_PATH=/app/data/audit-keys/ed25519-private.pem

# --- Service mesh URLs -------------------------------------------------------
# Container DNS names of the sibling services. Only the controller needs all
# five; the individual services get only the URLs they actually call.
BAYORA_RED_SERVICE_URL=http://red-service:8001
BAYORA_BLUE_SERVICE_URL=http://blue-policy-service:8002
BAYORA_MODEL_GATEWAY_URL=http://model-gateway:8003
BAYORA_EVALUATION_SERVICE_URL=http://evaluation-service:8004
BAYORA_AUDIT_COLLECTOR_URL=http://audit-collector:8005

# --- Resource limits and governance -----------------------------------------
BAYORA_MAX_PROMPT_CHARS=4000
BAYORA_MAX_OUTPUT_CHARS=4000
BAYORA_MAX_REQUEST_BYTES=65536
BAYORA_MODEL_TIMEOUT_SECONDS=30
BAYORA_EVAL_CONCURRENCY=2
BAYORA_EVAL_SYNC=false
BAYORA_RATE_LIMIT_PER_MINUTE=240
BAYORA_LOGIN_RATE_LIMIT_PER_MINUTE=10
BAYORA_PROBE_RATE_LIMIT_PER_MINUTE=60
BAYORA_MAX_PROBE_BUDGET=200
BAYORA_INTERNAL_TIMEOUT_SECONDS=60.0
BAYORA_MAX_UPLOAD_BYTES=524288000

# --- Model adapters ----------------------------------------------------------
# The model server. Only reachable from the model gateway.
BAYORA_OLLAMA_BASE_URL=http://ollama:11434
# Leave false to keep all model access behind the local model server.
BAYORA_EXTERNAL_MODELS_ENABLED=false
# Comma-separated allow-list of permitted external model hosts. Empty means
# nothing external is reachable.
BAYORA_EXTERNAL_HOST_ALLOWLIST=
# Hugging Face metadata import. Off by default; enabling it opens a path to
# the public internet from whichever service performs the import.
BAYORA_HF_IMPORT_ENABLED=false
BAYORA_HF_API_BASE=https://huggingface.co

# --- Test-only control -------------------------------------------------------
# NEGATIVE CONTROL. Enables a deliberately simulated cross-session context
# leak so the isolation canary can be shown to actually detect a leak.
# NEVER enable this outside a controlled experiment: it makes the model
# gateway leak context between sessions on purpose.
BAYORA_MOCK_SHARED_CONTEXT_BUG=false

# --- Audit -------------------------------------------------------------------
# The audit log stores synthetic prompts and outputs from the demo workload.
# Set to false to keep only hashes and metadata.
BAYORA_RETAIN_RAW_PROMPTS=true
# Interval of the background chain verification, in seconds. 0 disables it.
BAYORA_AUDIT_VERIFY_INTERVAL_SECONDS=300

# --- Authentication and session ---------------------------------------------
BAYORA_SESSION_TTL_MINUTES=480
# true requires HTTPS for the session cookie. Set true whenever the stack is
# reachable over anything other than plain localhost.
BAYORA_COOKIE_SECURE=true
BAYORA_COOKIE_NAME=bayora_session
# Comma-separated list of allowed browser origins.
BAYORA_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# --- Frontend ingress --------------------------------------------------------
# The SPA is served by nginx on port 8080 and proxies /api/ to the
# controller. The controller's own port is published on 127.0.0.1 only.
